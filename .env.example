# SRJ Wikidata MCP Server — environment variables.
# Copy to .env (gitignored) for local development.

# Wikimedia OAuth 2.0 owner-only consumer ACCESS TOKEN.
# Register at: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
#   - Tick "This consumer is for use only by <your username>"
#   - Grants needed: "Edit existing pages" and "Create, edit, and move pages"
#   - Wikidata item edits go through the Action API, so basic edit grants suffice
# Leave blank to run READ-ONLY — every read tool still works.
WIKIDATA_OAUTH_TOKEN=

# Admin bearer token for curl probes. 48+ chars.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WIKIDATA_MCP_TOKEN=

# Public issuer URL used by Claude.ai to build OAuth endpoints.
WIKIDATA_MCP_ISSUER_URL=https://srj-wikidata-mcp.onrender.com

# Wikimedia requires a descriptive, contactable User-Agent.
WIKIDATA_USER_AGENT=srj-wikidata-mcp/1.0 (https://srjconsultingservices.com; srj@srjconsultingservices.com)

# Self-imposed seconds between write calls, and maxlag threshold.
WIKIDATA_WRITE_INTERVAL=2.0
WIKIDATA_MAXLAG=5

LOG_LEVEL=INFO
